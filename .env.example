# personal-os — environment variables
# Copy to .env and fill in what you use. NEVER commit .env.

# ── AI APIs ──────────────────────────────────────────────
ANTHROPIC_API_KEY=            # Claude API
OPENAI_API_KEY=               # optional
GEMINI_API_KEY=               # optional

# ── Your platforms (add/remove to match your stack) ─────
NOTION_TOKEN=                 # Notion integration token
GOOGLE_CREDENTIALS_PATH=.secrets/credentials.json
GOOGLE_TOKEN_PATH=.secrets/token.json
AIRTABLE_API_KEY=
N8N_URL=                      # if you run n8n for automations
N8N_API_KEY=
